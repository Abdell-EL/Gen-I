# Secrets
.env
.env.*
!.env.example
# Not a secret: fixes the production build calling the API at a hardcoded
# dev-only localhost:8000 instead of through nginx's own /api/ proxy.
!backend/frontend/.env.production

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

