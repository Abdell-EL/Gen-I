backend/frontend/node_modules/
backend/frontend/dist/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary / backups
*.bak
*.backup.*
requirements.txt.utf16.bak

