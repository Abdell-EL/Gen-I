AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=sogetrel-knowledge-api
AUTH_JWT_AUDIENCE=sogetrel-knowledge-frontend
AUTH_ACCESS_TOKEN_MINUTES=15

FRONTEND_ACTIVATION_URL=http://localhost:5173/activate
INVITATION_TOKEN_LIFETIME_MINUTES=1440
INVITATION_EMAIL_PROVIDER=noop
INVITATION_RESEND_COOLDOWN_SECONDS=60
INVITATION_EXPOSE_ACTIVATION_URL=false

REDIS_URL=redis://redis:6379/0
CACHE_ENABLED=true
CACHE_NAMESPACE=lab-ia-genius
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_SEARCH_TTL_SECONDS=300
CACHE_EMBEDDING_TTL_SECONDS=3600
CACHE_VERSION=v1

OLLAMA_URL=http://ollama:11434/api/generate
OLLAMA_MODEL=llama3.2:3b
OLLAMA_FAST_MODEL=llama3.2:1b
OLLAMA_USE_FAST_MODEL=false
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=350
OLLAMA_TEMPERATURE=0.1
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
OLLAMA_MAX_CONTEXT_CHARS=12000
