AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=sogetrel-knowledge-api
AUTH_JWT_AUDIENCE=sogetrel-knowledge-frontend
AUTH_ACCESS_TOKEN_MINUTES=15

FRONTEND_ACTIVATION_URL=http://localhost:5173/activate
INVITATION_TOKEN_LIFETIME_MINUTES=1440
INVITATION_EMAIL_PROVIDER=noop
INVITATION_RESEND_COOLDOWN_SECONDS=60
INVITATION_EXPOSE_ACTIVATION_URL=false

FRONTEND_PASSWORD_RESET_URL=http://localhost:5173/reset-password
PASSWORD_RESET_EMAIL_PROVIDER=noop
PASSWORD_RESET_EXPOSE_URL=false
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60

REDIS_URL=redis://redis:6379/0

# Production: set a dedicated AUTH_RATE_LIMIT_HMAC_SECRET.
# Local/test fallback: AUTH_JWT_SECRET is only used as a safe dev fallback when the
# dedicated secret is absent and the workload is not production-facing.
AUTH_RATE_LIMIT_ENABLED=false
AUTH_RATE_LIMIT_REDIS_URL=redis://redis:6379/0
AUTH_RATE_LIMIT_NAMESPACE=lab-ia-genius
AUTH_RATE_LIMIT_HMAC_SECRET=
AUTH_RATE_LIMIT_REDIS_FAILURE_MODE=fail_open
AUTH_RATE_LIMIT_SIGNIN_ACCOUNT_LIMIT=5
AUTH_RATE_LIMIT_SIGNIN_ACCOUNT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_SIGNIN_IP_LIMIT=20
AUTH_RATE_LIMIT_SIGNIN_IP_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_SIGNIN_COMBINED_LIMIT=5
AUTH_RATE_LIMIT_SIGNIN_COMBINED_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_SIGNIN_COOLDOWN_SECONDS=900
AUTH_RATE_LIMIT_FORGOT_ACCOUNT_LIMIT=3
AUTH_RATE_LIMIT_FORGOT_ACCOUNT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_FORGOT_IP_LIMIT=10
AUTH_RATE_LIMIT_FORGOT_IP_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_RESET_VALIDATE_TOKEN_LIMIT=10
AUTH_RATE_LIMIT_RESET_VALIDATE_TOKEN_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_RESET_VALIDATE_IP_LIMIT=30
AUTH_RATE_LIMIT_RESET_VALIDATE_IP_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_RESET_COMPLETE_TOKEN_LIMIT=5
AUTH_RATE_LIMIT_RESET_COMPLETE_TOKEN_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_RESET_COMPLETE_IP_LIMIT=20
AUTH_RATE_LIMIT_RESET_COMPLETE_IP_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_ACTIVATION_VALIDATE_TOKEN_LIMIT=10
AUTH_RATE_LIMIT_ACTIVATION_VALIDATE_TOKEN_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_ACTIVATION_VALIDATE_IP_LIMIT=30
AUTH_RATE_LIMIT_ACTIVATION_VALIDATE_IP_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_ACTIVATION_COMPLETE_TOKEN_LIMIT=5
AUTH_RATE_LIMIT_ACTIVATION_COMPLETE_TOKEN_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_ACTIVATION_COMPLETE_IP_LIMIT=20
AUTH_RATE_LIMIT_ACTIVATION_COMPLETE_IP_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_INVITATION_RESEND_ACTOR_LIMIT=10
AUTH_RATE_LIMIT_INVITATION_RESEND_ACTOR_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_INVITATION_RESEND_TARGET_LIMIT=5
AUTH_RATE_LIMIT_INVITATION_RESEND_TARGET_WINDOW_SECONDS=900

CACHE_ENABLED=true
CACHE_NAMESPACE=lab-ia-genius
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_SEARCH_TTL_SECONDS=300
CACHE_EMBEDDING_TTL_SECONDS=3600
CACHE_VERSION=v1

OLLAMA_URL=http://ollama:11434/api/generate
OLLAMA_MODEL=llama3.2:3b
OLLAMA_FAST_MODEL=llama3.2:1b
OLLAMA_USE_FAST_MODEL=false
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=350
OLLAMA_TEMPERATURE=0.1
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
OLLAMA_MAX_CONTEXT_CHARS=12000
